# =============================================================================
# Scraper configuration -- copy to ".env" and edit. Nothing here is required:
# every setting has a working default baked into the code, so a fresh checkout
# runs with no .env at all. Credentials are the exception -- the scrapers that
# need them refuse to start without them.
#
# Precedence, highest first:
#   1. a real shell export        (SCRAPE_MODE=accounts python tel-scraper.py)
#   2. a per-scraper name in .env (YT_MAX_PAST_MINUTES=1440)
#   3. a shared name in .env      (MAX_PAST_MINUTES=60)
#   4. the default in the code
#
# Per-scraper prefixes:  X_ (Twitter/X)  YT_ (YouTube)  TEL_ (Telegram)
#                        RD_ (Reddit)    TT_ (TikTok)   TS_ (Truth Social)
#
# A malformed value is logged and ignored in favour of the default, so a typo
# never takes down an unattended cron run.
# =============================================================================


# -----------------------------------------------------------------------------
# Credentials (never commit a filled-in .env)
# -----------------------------------------------------------------------------
# Telegram -- create an application at https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Name of the .session file written on first (interactive) login.
#TELEGRAM_SESSION_NAME=sessions/tel-scraper

# Reddit -- Data API client credentials, read-only (no account password).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
#REDDIT_USER_AGENT=python:social-media-scraping:1.0 (read-only research)

# Truth Social -- account credentials, or a bearer token to skip the login.
TRUTHSOCIAL_USERNAME=
TRUTHSOCIAL_PASSWORD=
#TRUTHSOCIAL_TOKEN=
# Public web-client values shipped in the site's JavaScript, not secrets.
# Only set these if Truth Social rotates them.
#TRUTHSOCIAL_CLIENT_ID=
#TRUTHSOCIAL_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# Discovery mode -- the main run-time switch
# -----------------------------------------------------------------------------
# accounts = walk the trusted accounts/channels/subreddits and keep EVERY post
#            inside the time window, unfiltered. Output is one file per account.
# keyword  = search per keyword, scoped to the trusted accounts, as before.
#            Output is one file per keyword.
#
# Set this and the scrapers never ask anything on the terminal, which is what a
# cron/bash wrapper needs. If it is unset and no terminal is attached, the
# scrapers use "keyword".
#
# Telegram is account-driven by design and ignores this setting.
# TikTok and Truth Social have no free search API, so their keyword mode reads
# the same trusted-account timelines and keeps the posts that match a keyword.
SCRAPE_MODE=keyword
#YT_SCRAPE_MODE=accounts


# -----------------------------------------------------------------------------
# Collection window -- how far back a run looks, in MINUTES for every scraper
# -----------------------------------------------------------------------------
# Keep this comfortably larger than the interval your scheduler runs the
# scrapers at, so nothing falls between two runs.
#   60 = 1 hour   1440 = 1 day   10080 = 1 week   43200 = 30 days
MAX_PAST_MINUTES=43200
#TEL_MAX_PAST_MINUTES=1440


# -----------------------------------------------------------------------------
# Language handling
# -----------------------------------------------------------------------------
# Comma-separated ISO codes. Nothing is translated: every record is stored and
# analysed in its own language, and there is no translated_text field.
ALLOWED_LANGUAGES=en,fa
# A record is dropped ONLY when the detector is CONFIDENT its language is
# outside ALLOWED_LANGUAGES -- i.e. detected-language-not-listed AND
# confidence >= this value. A low-confidence verdict means the detector does
# not know (normal for a three-word post or a caption of hashtags) and the
# record is kept. Raise this to drop fewer records, lower it to drop more.
LANGUAGE_MIN_CONFIDENCE=0.70


# -----------------------------------------------------------------------------
# How much to collect per keyword / per account
# -----------------------------------------------------------------------------
#X_MAX_RESULTS_PER_KEYWORD=100
#X_ACCOUNT_MODE_FETCH_LIMIT=200
#YT_MAX_RESULTS_PER_KEYWORD=30
#YT_MAX_VIDEOS_PER_CHANNEL=50
#YT_MAX_VIDEO_DURATION_SECONDS=3600
#TEL_MAX_MESSAGES_PER_CHANNEL=500
#RD_MAX_RESULTS_PER_KEYWORD=50
#RD_MAX_POSTS_PER_SUBREDDIT=100
#TT_MAX_VIDEOS_PER_ACCOUNT=30
#TT_MAX_VIDEO_DURATION_SECONDS=1800
#TS_MAX_POSTS_PER_ACCOUNT=80


# -----------------------------------------------------------------------------
# Pacing and concurrency -- lower these if a platform starts rate-limiting you
# -----------------------------------------------------------------------------
# Delay ranges are "min,max" seconds and are jittered inside that range.
#X_FETCH_MAX_WORKERS=10
#X_FETCH_MIN_INTERVAL=0.5
#X_DDGS_DELAY_RANGE=12,18
#X_DDGS_MAX_RETRIES=3
#YT_FETCH_MAX_WORKERS=4
#YT_FETCH_MIN_INTERVAL=1.0
#YT_SEARCH_DELAY_RANGE=8,14
#YT_SEARCH_MAX_RETRIES=3
#TEL_CHANNEL_DELAY_RANGE=3,6
#RD_SEARCH_DELAY_RANGE=3,6
#TT_FETCH_MIN_INTERVAL=2.0
#TT_ACCOUNT_DELAY_RANGE=5,10
#TS_FETCH_MIN_INTERVAL=1.5
#TS_ACCOUNT_DELAY_RANGE=3,6
#TS_PAGE_SIZE=40

# Telegram flood control. Telethon sleeps through waits shorter than the
# threshold itself; longer ones are retried for exactly the time Telegram asks.
#TEL_FLOOD_SLEEP_THRESHOLD=60
#TEL_FLOOD_WAIT_BUFFER=5
#TEL_MAX_FLOOD_RETRIES=3

# Telegram only: re-scan the whole window so edits to already-saved messages
# refresh the stored record. false = cheaper append-only run that never sees an edit.
#TEL_REFRESH_EDITED_MESSAGES=true


# -----------------------------------------------------------------------------
# Models (all local/open-source; downloaded once to the Hugging Face cache)
# -----------------------------------------------------------------------------
# Nothing in this pipeline translates. Every record is analysed in its own
# language and records carry no translated_text field.

# Financial sentiment for ENGLISH records. 3-class positive/neutral/negative.
#SENTIMENT_MODEL=ProsusAI/finbert

# Sentiment for every OTHER language (Persian included). FinBERT is
# English-only -- fed Persian it tokenizes to mostly [UNK] and returns a label
# built out of noise. Set to "none" to leave non-English sentiment null instead.
#MULTILINGUAL_SENTIMENT_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment

# Asset relevance (NLI). Must be a THREE-class model whose labels include
# entailment / neutral / contradiction -- two-class "zeroshot-v2.0" style
# models have no contradiction label and silently disable the false-positive
# filter below. One size down: MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli
#ASSET_NLI_MODEL=MoritzLaurer/DeBERTa-v3-large-mnli-fever-anli-ling-wanli
#ASSET_NLI_DEVICE=auto          # auto | cuda | cpu
#ASSET_NLI_BATCH_SIZE=16
#ASSET_CONTEXT_MAX_RESULTS=0    # 0 = keep every context asset the model accepts
# Drop a literal alias match the model actively contradicts below this
# entailment probability ("Shell" the noun, "gold" the colour). 0 disables.
#ASSET_DIRECT_MIN_CONFIDENCE=0.10
# The NLI model reads English only, so it is skipped entirely for non-Latin
# text: a Persian record's direct alias/cashtag matches are kept as-is with a
# null confidence rather than being judged by a model that cannot read them.

# Whisper's task for the audio fallback. "translate" emits an English
# transcript of non-English speech; "transcribe" keeps the spoken language.
# This is the one remaining place a non-English source becomes English, and it
# is deliberate: for a video with no captions the transcript IS the record's
# only text, so nothing original is being replaced. Set to "transcribe" to keep
# spoken Persian as Persian (sentiment then uses the multilingual model).
#WHISPER_TASK=translate

# Speech-to-text fallback for YouTube/TikTok when no captions exist.
# tiny | base | small | medium | large-v3 -- bigger is slower but more accurate.
#WHISPER_MODEL_SIZE=small


# -----------------------------------------------------------------------------
# X (Twitter) keyword-mode credibility gate
# -----------------------------------------------------------------------------
# In keyword mode the trusted list in sources/twtr-accounts.txt PRIORITISES
# rather than filters: a trusted author is always kept, and an author outside
# the list is kept when the post clears ANY ONE of these bars. Set all three
# to 0 to keep every author found.
#X_UNTRUSTED_MIN_FOLLOWERS=20000
#X_UNTRUSTED_MIN_LIKES=1000
#X_UNTRUSTED_MIN_VIEWS=10000

# Account mode reads X's public syndication timeline first (no auth, 20-100
# complete tweets per account). If that ever fails it falls back to xtf, which
# needs a reachable Nitter instance -- set one here, otherwise xtf reports
# all_backends_failed and the run drops to a low-yield DuckDuckGo search.
#XTF_NITTER=https://nitter.example.com,https://xcancel.com

# Pause between accounts in X account mode. The syndication endpoint is
# unauthenticated and answers a burst with HTTP 429, so a long account list
# needs real pacing or most of it degrades to the DuckDuckGo fallback.
#X_ACCOUNT_DELAY_RANGE=3.0,6.0


# -----------------------------------------------------------------------------
# Truth Social
# -----------------------------------------------------------------------------
# Replies are posts the account made too, so they are collected by default.
# true = top-level posts only.
#TS_EXCLUDE_REPLIES=false
